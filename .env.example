# ==========================
# CONFIGURAÇÃO DE IA (LLM)
# ==========================

# Qual provedor usar quando o sistema de regras não reconhece
# o comando: "openai" ou "anthropic"
PROVEDOR_LLM=openai

# Preencha a chave do provedor escolhido acima
OPENAI_API_KEY=
MODELO_OPENAI=gpt-4o-mini

ANTHROPIC_API_KEY=
MODELO_ANTHROPIC=claude-sonnet-4-5

# Quantas trocas de mensagens recentes do histórico são
# enviadas como contexto para o LLM
HISTORICO_CONTEXTO=10

# Se "false", a ORION volta a responder apenas com o
# sistema de regras antigo quando não reconhecer o comando
USAR_LLM=true
